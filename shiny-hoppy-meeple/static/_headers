# Response headers for the static assets Cloudflare Pages serves itself.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Pages does NOT apply this file to Functions responses, so the JSON APIs set
# their own security headers — see functions/_lib/json.js.

# Hugo fingerprints the theme bundles with a sha512 content hash, so a change
# always means a new filename: they can be cached for as long as we like.
/css/main.bundle.min.*
  Cache-Control: public, max-age=31536000, immutable

/js/main.bundle.min.*
  Cache-Control: public, max-age=31536000, immutable

/js/appearance.min.*
  Cache-Control: public, max-age=31536000, immutable

/lib/zoom/zoom.min.umd.*
  Cache-Control: public, max-age=31536000, immutable

# Game art from the BGG export. Filenames are BGG ids rather than content
# hashes and the daily re-export can change what sits behind one, so a day is
# the safe ceiling.
/images/games/*
  Cache-Control: public, max-age=86400

# Deliberately not listed: /css/bgg.css, /css/calendar.css, /js/game-finder.js
# and /js/plays.js. They ship straight out of static/ with no fingerprint, so a
# long max-age would strand visitors on a stale copy after an edit. Move them
# into assets/ and through Hugo's fingerprint pipe to make them cacheable.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
